classDiagram
    direction TB

    class GatewayHandler {
        +handle(request) Response
    }

    class RequestContext {
        provider_id: bigint
        api_id: bigint
        method: str
        path: str
        raw_key: str
        bundle: dict "set by KeyAuthCheck"
        rl_remaining: int "set by RateLimitCheck"
        quota_used: int "set by QuotaCheck"
    }

    class CheckResult {
        allowed: bool
        outcome: str
        http_status: int
        detail: str
        headers: dict
    }

    class RequestCheck {
        <<interface>>
        +check(ctx) CheckResult
    }

    class KeyAuthCheck {
        +check(ctx) CheckResult
    }
    note for KeyAuthCheck "Key validity AND subscription in one check:\nthe authorization join (D-002) resolves both\nin a single Redis-cached query."

    class RateLimitCheck {
        +check(ctx) CheckResult
    }

    class QuotaCheck {
        +check(ctx) CheckResult
    }

    class CheckPipeline {
        checks: List~RequestCheck~
        +run(ctx) CheckResult
    }
    note for CheckPipeline "Runs checks in order, stops at first failure.\nOrder is a contract: auth before limits,\nrate limit before quota."

    class RouteResolver {
        <<module: gateway.routing>>
        +resolve_route(provider_slug, api_slug) dict
    }

    class AuthResolver {
        <<module: gateway.auth>>
        +resolve_auth(raw_key, api_id) dict
    }

    class TokenBucketLimiter {
        <<module: gateway.ratelimit + Redis Lua>>
        +check_rate_limit(sub_id, requests, window, burst)
    }

    class QuotaStore {
        <<module: gateway.quota + Redis INCR>>
        +check_and_increment_quota(sub_id, quota, overage)
    }

    class UsageRecorder {
        <<module: gateway.metering>>
        +record(event) "async queue, batched INSERT"
    }

    RequestCheck <|.. KeyAuthCheck
    RequestCheck <|.. RateLimitCheck
    RequestCheck <|.. QuotaCheck
    CheckPipeline o-- RequestCheck

    GatewayHandler --> RouteResolver
    GatewayHandler --> CheckPipeline
    GatewayHandler --> UsageRecorder

    KeyAuthCheck --> AuthResolver
    RateLimitCheck --> TokenBucketLimiter
    QuotaCheck --> QuotaStore

    CheckPipeline ..> RequestContext
    RequestCheck ..> CheckResult